@startuml
!theme plain
title Portfolio - frontend layers
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle

package "Frontend design scope" {
  package "Presentation layer" {
    component "Application shell\nResponsive theme and navigation" as Shell
    component "Project views\nShowroom, details and studio" as Projects
    component "React feed \nFeedPage, ProjectPost, media, likes, comments" as Feed
    component "Profile / CV views" as Profile
    component "Account views" as Account
    component "Shared UI\nForms, dialogs, placeholders and feedback" as UI
  }
  package "Interaction and state layer" {
    component "Interaction coordinator\nRoutes, forms, slideshow, galleries\nand request state" as Interaction
    rectangle "Transient UI state\nTabs, filters and unsent form edits" as State
    component "Feed state \nCursor, fetched IDs, observer, aborts" as FeedState
  }
  package "API integration layer" {
    component "API client\nAccount, project, profile, file\nand access operations" as Client
  }
}
rectangle "External boundary - outside frontend design" #F0F0F0 {
  component "Backend API\nAuth/project services exist;" as Backend
}

Shell --> Interaction : navigation intent
Projects --> Interaction : project and editor intent
Shell --> Feed : mount / account update / unmount
Feed --> FeedState : initial and next-page intent
FeedState --> Client : bounded public reads and authenticated writes
Feed --> UI : consistent visual theme and status feedback
Profile --> Interaction : profile and CV intent
Account --> Interaction : account intent
Projects --> UI : shared presentation
Profile --> UI : shared presentation
Account --> UI : shared presentation
Interaction --> State : manage transient interaction state
Interaction --> UI : present pending, success and failure states
Interaction --> Client : request data and submit changes
Client --> Backend : API requests and responses

@enduml
