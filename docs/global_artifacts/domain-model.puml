@startuml
!theme plain
title Portfolio domain model
hide empty members
skinparam classAttributeIconSize 0

class "User Account" as UserAccount {
  id
  name
  email
  passwordHash
  createdAt
}

class "Project Collaboration" as ProjectCollaboration {
    role
}

class Project {
    title
    showcase type
    description
    tech stack
    published
    collaborationNotes
    createdAt
}

class "Media Item" as MediaItem {
    name
    media type
    size
    position
}

class "Feed Post" as FeedPost {
    createdAt
}

class "Post Like" as PostLike {
    createdAt
}

class "Post Comment" as PostComment {
    id
    text
    createdAt
}

class Notes {
    idea
    compatibility
    source repository
    release notes
}

class "DownloadableBuild" as Build {
    build file
    download permissions
}

class "Portfolio Profile" as Profile {
    name
    role
    location
    email
    about you
    experience
    education
    skills
    github URL
    linkedin URL
}

class "CV File" as CV {
    cv file
}
class "Sign-in Session" as SignInSession {
    id
    userId
    refreshTokenHash
    createdAt
    lastRefreshedAt
    revokedAt
    expiresAt
}

class "Provider Identity" as ProviderIdentity {
  provider
  providerUserId
  linkedAt
}

UserAccount "1" -- "0..*" ProviderIdentity : links

UserAccount "1" -- "0..*" Project : creates
UserAccount "1" -- "0..1" Profile : owns
Project "1" *-- "0..1" Build : has
UserAccount "1" -- "0..*" SignInSession : starts
Project "1" *-- "0..1" Notes : contains
Project "1" *-- "1..*" MediaItem : orders in gallery
Project "1" -- "0..1" FeedPost : is represented by
UserAccount "1" -- "0..*" FeedPost : owns
FeedPost "0..1" --> "1" MediaItem : owns
FeedPost "1" *-- "0..*" PostLike : receives
UserAccount "1" -- "0..*" PostLike : gives
FeedPost "1" *-- "0..*" PostComment : contains
UserAccount "1" -- "0..*" PostComment : writes
Profile "1" *-- "0..1" CV : has
UserAccount "1" -- "0..*" ProjectCollaboration : holds
Project "1" *-- "1..*" ProjectCollaboration : credits

note left of ProjectCollaboration
  One membership per project and account.
  Roles are Owner, Team Member, and Simple Participation.
  The creator always holds a Owner membership.
end note

note top of UserAccount
  Registration requires a name, email, and password.
  Each normalized email identifies at most one account.
  Store the bcrypt hash of the submitted password.
end note

@enduml
