{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "storage:setup": "node scripts/setup-project-storage.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/registration.test.js tests/login.test.js tests/oauth.test.js tests/projects.test.js tests/cv.test.js tests/feed.test.js",
    "test:e2e": "playwright test",
    "build:feed": "vite build",
    "build": "npm run build:feed",
    "prestart": "npm run build:feed",
    "predev": "npm run build:feed",
    "pretest:e2e": "npm run build:feed",
    "dev:feed": "vite build --watch"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
