DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=./src/db/certs/supabase-root-2021.crt
PORT=3000

# Project files: production and configured Supabase environments use a private project-files bucket.
# Run npm run storage:setup once before deploying. Local-only development can use local.
# PROJECT_STORAGE_DRIVER=supabase
# PROJECT_UPLOAD_DIR=/absolute/path/to/local-project-files

# Optional locally. Set a random secret of at least 32 bytes in production.
# JWT_SECRET=

# Optional provider sign-in.
# OAUTH_ORIGIN=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Shared server-only Supabase Storage credentials for project-files and cv-files.
# Create project-files with npm run storage:setup; create private cv-files for PDFs.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_STORAGE_KEY=
