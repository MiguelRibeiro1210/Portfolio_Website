DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=./src/db/certs/supabase-root-2021.crt
PORT=3000

# Optional. Use persistent disk when hosting (default: src/uploads/projects/).
# PROJECT_UPLOAD_DIR=/absolute/path/to/project-files

# Optional locally. Set a random secret of at least 32 bytes in production.
# JWT_SECRET=

# Optional provider sign-in.
# OAUTH_ORIGIN=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
